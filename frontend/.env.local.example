# 로컬 개발: 이 파일을 복사해 frontend/.env.local로 저장하고 값을 채운다.
# 배포(Vercel): 아래 키를 그대로 프로젝트 환경변수로 등록한다.

# 카카오톡 공유하기(JS SDK) — Kakao.init()에 넘기는 JavaScript 키
# 콘솔 > 플랫폼 > Web 플랫폼에 이 앱이 실행되는 도메인(로컬 http://localhost:3000,
# 배포 시 실제 Vercel 도메인)을 등록해야 동작한다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# /api/* 요청을 프록시할 백엔드(Railway 등) 도메인. next.config.mjs의 rewrites가 읽는다
# (서버 사이드 전용이라 NEXT_PUBLIC_ 접두사가 필요 없다). 미설정 시 로컬 기본값
# (http://localhost:4000)으로 동작한다.
BACKEND_ORIGIN=

# 브라우저가 API를 직접 호출할 때 쓰는 같은 백엔드 도메인. 클라이언트 번들에 노출돼야 해서
# NEXT_PUBLIC_ 접두사가 필요하다(src/lib/api/authFetch.ts의 apiUrl 참고). BACKEND_ORIGIN과
# 값은 동일하지만 용도(서버 rewrite vs 브라우저 직접 호출)가 달라 별도 변수로 둔다.
# 미설정 시(로컬 개발) 빈 문자열이라 기존처럼 rewrites 프록시를 그대로 탄다.
NEXT_PUBLIC_API_ORIGIN=
