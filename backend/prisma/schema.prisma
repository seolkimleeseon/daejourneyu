// 대저니유 데이터 모델. 지금은 인증(User)과 반려동물(Pet)만 있고, 장소·코스는 목데이터를 쓰는 단계다.
// 스키마를 고친 뒤에는 반드시 `npx prisma migrate dev`로 마이그레이션을 남긴다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  /// 카카오는 이메일 제공에 동의를 받아야 하므로 없을 수 있다.
  email    String? @unique
  nickname String
  /// bcrypt 해시. 평문 비밀번호는 어디에도 저장하지 않는다. 소셜 계정은 null.
  passwordHash String?

  /// "local" | "kakao"
  provider String @default("local")
  /// 소셜 제공자가 발급한 회원번호. local 계정은 null.
  providerId String?

  pets Pet[]
  courses Course[]
  posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  @@map("users")
}

/// 반려동물. 사용자당 여러 마리를 등록할 수 있고, 마이탭에서 활성 개체를 전환한다.
model Pet {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  breed    String
  weightKg Float
  ageYears Int
  /// "소형견" | "중형견" | "대형견" — 장소별 동반 조건 판단에 쓰인다.
  size  String
  emoji String

  /// MBTI는 사람이 아니라 반려동물의 성향 유형이다. 퀴즈를 아직 안 봤으면 전부 null.
  mbtiCode   String?
  mbtiName   String?
  mbtiTheme  String?
  mbtiTraits String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("pets")
}

model Course {
  id        String   @id @default(cuid())
  label     String
  emoji     String?
  nights    Int
  transport String
  source    String
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  days     CourseDay[]
  schedule CourseSchedule?
  posts    Post[]
}

model CourseDay {
  id       String @id @default(cuid())
  dayIndex Int

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stops    CourseStop[]

  @@unique([courseId, dayIndex])
}

model CourseStop {
  id          String  @id @default(cuid())
  order       Int
  placeId     String
  name        String
  category    String
  district    String
  condition   String
  petFriendly Boolean
  imageUrl    String?

  courseDayId String
  courseDay   CourseDay @relation(fields: [courseDayId], references: [id], onDelete: Cascade)

  @@unique([courseDayId, order])
}

model CourseSchedule {
  id   String @id @default(cuid())
  date String

  courseId String @unique
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  festivalTitles CourseScheduleFestival[]
}

model CourseScheduleFestival {
  id    String @id @default(cuid())
  title String

  courseScheduleId String
  courseSchedule CourseSchedule @relation(fields: [courseScheduleId], references: [id], onDelete: Cascade)
}

model Place {
  id           String   @id
  name         String
  category     String
  district     String
  condition    String
  petFriendly  Boolean
  smallDogOnly Boolean  @default(false)
  lat          Float
  lng          Float
  imageUrl     String?
  source       String
  sourceTier   Int
  updatedAt    DateTime @updatedAt
}

/// 둘러보기(FEED)에 공유된 "코스 게시물". 코스 보관함에서 '코스 자랑하기'로 올라온다.
model Post {
  id String @id @default(cuid())

  /// 올릴 때의 코스 이름. 코스를 지우거나 이름을 바꿔도 이미 올린 글은 그대로 남아야 한다.
  caption String
  /// 작성자가 남긴 한마디. 비워 둘 수 있다.
  text String @default("")
  /// 일정·이동수단·자치구처럼 코스에서 자동으로 뽑아 붙인 태그.
  tags String[]

  /// 작성자 표시용 스냅샷 — 활성 반려동물은 언제든 바뀌므로 글에 고정해 둔다.
  authorName  String
  authorEmoji String
  /// 반려동물 MBTI 풀네임. 아직 검사 전이면 안내 문구가 그대로 들어온다.
  petTypeName String

  /// TODO(api): 좋아요/담기 토글이 서버로 넘어오기 전까지는 0에서 움직이지 않는다.
  likes Int @default(0)
  saves Int @default(0)

  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 어떤 코스를 자랑한 글인지. 코스를 지워도 글은 남겨야 하므로 SetNull로 끊는다.
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  stops PostStop[]

  @@index([userId])
  @@index([courseId])
}

/// 게시물에 박제된 방문 장소. 코스가 나중에 바뀌어도 글에 보이는 동선은 올릴 때 그대로여야 한다.
model PostStop {
  id          String  @id @default(cuid())
  order       Int
  placeId     String
  name        String
  category    String
  district    String
  condition   String
  petFriendly Boolean
  imageUrl    String?

  postId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, order])
}
