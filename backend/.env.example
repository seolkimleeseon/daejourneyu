# 로컬 개발용 PostgreSQL 접속 주소.
# Docker/Homebrew 없이 띄우려면 `npx prisma dev`를 실행하고 출력되는 URL을 여기에 붙여넣는다.
# prisma dev로 띄운 경우 pgbouncer=true를 붙여야 prepared statement 충돌이 나지 않는다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daejourneyu?schema=public"

# 액세스 토큰 서명 키. 운영에서는 반드시 길고 무작위한 값으로 교체한다.
JWT_SECRET="change-me-in-production"
