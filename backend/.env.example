# 로컬 개발용 PostgreSQL 접속 주소.
# Docker/Homebrew 없이 띄우려면 `npx prisma dev`를 실행하고 출력되는 URL을 여기에 붙여넣는다.
# prisma dev로 띄운 경우 pgbouncer=true를 붙여야 prepared statement 충돌이 나지 않는다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daejourneyu?schema=public"

# 액세스 토큰 서명 키. 운영에서는 반드시 길고 무작위한 값으로 교체한다.
JWT_SECRET="change-me-in-production"

# 카카오 로그인 — https://developers.kakao.com 에서 앱을 만들고 "카카오 로그인"을 활성화한 뒤,
# 아래 Redirect URI를 콘솔의 "Redirect URI"에 그대로 등록해야 한다.
# REST API 키는 P2가 쓰는 카카오 로컬 API와 같은 값을 재사용하면 된다.
KAKAO_REST_API_KEY=""
KAKAO_REDIRECT_URI="http://localhost:4000/api/auth/kakao/callback"
# 앱 설정에서 "보안 > Client Secret"을 켠 경우에만 채운다.
KAKAO_CLIENT_SECRET=""

# 카카오 로그인 완료 후 돌아갈 프론트 주소
FRONTEND_ORIGIN="http://localhost:3000"
